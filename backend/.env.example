# 复制为 .env 后按需修改
# 本地默认 SQLite；生产用 PostgreSQL：postgresql+psycopg2://user:pass@host:5432/pinyintone
DATABASE_URL=sqlite:///./pinyintone.db
# 生产请用 >=32 字节的随机串：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-change-me-in-production-0123456789
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=720
