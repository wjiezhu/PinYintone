# 复制为 .env 后按需修改
# 本地默认 SQLite；生产用 PostgreSQL：postgresql+psycopg2://user:pass@host:5432/pinyintone
DATABASE_URL=sqlite:///./pinyintone.db
# 生产请用 >=32 字节的随机串：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-change-me-in-production-0123456789
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=720
# 学生登录凭证校验（app/identity.py）。逗号分隔
APPLE_BUNDLE_IDS=Joy.PinYintone
# Android Credential Manager 的 serverClientId（Web client id），可再列 Android client id
GOOGLE_CLIENT_IDS=
# 过渡开关：没带 identityToken 的旧版 iOS Apple 登录是否放行
ALLOW_LEGACY_UNVERIFIED_APPLE=true
