# 复制为 .env 后按需修改
# 本地默认 SQLite；生产用 PostgreSQL：postgresql+psycopg2://user:pass@host:5432/pinyintone
DATABASE_URL=sqlite:///./pinyintone.db
# 生产请用 >=32 字节的随机串：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-change-me-in-production-0123456789
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=720
# 学生登录凭证校验（app/identity.py）。逗号分隔
APPLE_BUNDLE_IDS=Joy.PinYintone
# Android Credential Manager 的 serverClientId（Web client id），可再列 Android client id
GOOGLE_CLIENT_IDS=
# 过渡开关：没带 identityToken 的旧版 iOS Apple 登录是否放行
ALLOW_LEGACY_UNVERIFIED_APPLE=true

# 运行环境：development | production。留空时 PostgreSQL = 生产，其余 = 开发
APP_ENV=
# 邮箱验证码登录的发信器：console（只写日志，开发默认；生产拒用）| resend | smtp
# 生产环境留空或没配全 = 邮箱登录返回 503，不会悄悄只写日志
EMAIL_SENDER=console
# 发件人；域名须已在服务商处验证（SPF / DKIM / DMARC，见 README）
EMAIL_FROM=
# resend：Resend 后台生成，只给 Sending access
RESEND_API_KEY=
# smtp：阿里云邮件推送 / Amazon SES 等。SMTP_SECURITY = ssl（465）| starttls（587）
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=ssl
# 每小时发送上限
EMAIL_CODE_PER_EMAIL_PER_HOUR=5
EMAIL_CODE_PER_IP_PER_HOUR=30
# 取客户端 IP 时信任几层反向代理（Railway / Render 取 1）
TRUSTED_PROXY_HOPS=1

# Android 新版本检查（GET /api/app-version/android）。versionCode 是整数，与 App 的 build.gradle.kts 一致
# LATEST = 0 或 DOWNLOAD_URL 留空 = 不提示任何更新
ANDROID_LATEST_VERSION_CODE=0
ANDROID_LATEST_VERSION_NAME=
# 低于它的 App 提示「必须更新」（仍不拦练习，只是提示不能关）
ANDROID_MIN_VERSION_CODE=0
# 必须 https；App 用系统浏览器打开
ANDROID_DOWNLOAD_URL=
ANDROID_RELEASE_NOTES_ZH=
ANDROID_RELEASE_NOTES_EN=
ANDROID_RELEASE_NOTES_FR=
ANDROID_RELEASE_NOTES_AR=
