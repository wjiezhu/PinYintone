      "type": "single",
      "question": {
        "zh": "你是否已满18周岁？",
        "en": "Are you 18 years old or older?",
        "fr": "Avez-vous 18 ans ou plus ?",
        "ar": "هل تبلغ من العمر 18 عامًا أو أكثر؟",
        "es": "¿Tienes 18 años o más?",
        "it": "Hai almeno 18 anni?"
      },
      "options": [
        {
          "code": "adult",
          "label": {
            "zh": "是，我已满18周岁",
            "en": "Yes, I am 18 or older",
            "fr": "Oui, j’ai 18 ans ou plus",
            "ar": "نعم، أبلغ من العمر 18 عامًا أو أكثر",
            "es": "Sí, tengo 18 años o más",
            "it": "Sì, ho almeno 18 anni"
          }
        },
        {
          "code": "minor",
          "label": {
            "zh": "否，我未满18周岁",
            "en": "No, I am under 18",
            "fr": "Non, j’ai moins de 18 ans",
            "ar": "لا، عمري أقل من 18 عامًا",
            "es": "No, tengo menos de 18 años",
            "it": "No, ho meno di 18 anni"
          }
        },
        {
          "code": "prefer_not",
          "label": {
            "zh": "不愿回答",
            "en": "Prefer not to answer",
            "fr": "Je préfère ne pas répondre",
            "ar": "أفضل عدم الإجابة",
            "es": "Prefiero no responder",
            "it": "Preferisco non rispondere"
          },
          "exclusive": true
        }
      ]
    },
